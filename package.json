{
  "name": "motes-of-work",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:task": "playwright test --grep-invert @full-only",
    "e2e:full": "playwright test",
    "shots": "SHOTS=1 playwright test e2e/shots.spec.ts",
    "stills": "SHOTS=1 playwright test e2e/stills.spec.ts"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
